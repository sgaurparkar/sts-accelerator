# Copy to .env (never commit .env — it is in .gitignore) and fill in the values.
#
# SQL logins: one pair per SQL server, named
#     <RESOURCE_GROUP>_AZURE_SQL_<SERVER>_USERNAME / _PASSWORD
# where both parts are the Azure names upper-cased with every "-", "." or space turned into "_":
#     resource group ingredion-dev-rg-central-india     -> INGREDION_DEV_RG_CENTRAL_INDIA
#     server         ingredion-dev-server-central-indiaa -> INGREDION_DEV_SERVER_CENTRAL_INDIAA
# `python3 main.py --check-connections` prints, per database, exactly which variable it used.
# Other accepted names (first one set wins, see secrets.sql_name_templates in settings.yaml):
#     AZURE_SQL_<SERVER>_USERNAME, AZURE_SQL_USERNAME_<SERVER>, AZURE_SQL_USERNAME_<RESOURCE_GROUP>,
#     AZURE_SQL_USERNAME_<LOCATION>, AZURE_SQL_USERNAME   (shared by every server)
# Quote values that contain #, spaces or quotes.

# --- Azure SQL: Central India ------------------------------------------------------------
INGREDION_DEV_RG_CENTRAL_INDIA_AZURE_SQL_INGREDION_DEV_SERVER_CENTRAL_INDIAA_USERNAME=
INGREDION_DEV_RG_CENTRAL_INDIA_AZURE_SQL_INGREDION_DEV_SERVER_CENTRAL_INDIAA_PASSWORD=""

# --- Azure SQL: East US ------------------------------------------------------------------
INGREDION_DEV_RG_EAST_US_AZURE_SQL_INGREDION_DEV_SERVER_EAST_US_USERNAME=
INGREDION_DEV_RG_EAST_US_AZURE_SQL_INGREDION_DEV_SERVER_EAST_US_PASSWORD=""

# --- Azure Blob Storage (transfer.mode: sts) -----------------------------------------------
# Shared by every resource group. Per resource group / account / location also works:
#   <RESOURCE_GROUP>_AZURE_SAS_TOKEN, AZURE_SAS_TOKEN_<ACCOUNT>, AZURE_SAS_TOKEN_<LOCATION>
# The SAS token needs read + list on the container; --check-connections warns before it expires.
AZURE_SAS_TOKEN=""
AZURE_STORAGE_CONNECTION_STRING=""

# --- Azure Resource Manager discovery (azure_topology.source: arm) -------------------------
AZURE_SUBSCRIPTION_ID=               # comma-separated for several subscriptions
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure SQL with Entra instead of SQL logins (source.auth: entra_service_principal) ----
# <RESOURCE_GROUP>_AZURE_SQL_<SERVER>_CLIENT_ID / _CLIENT_SECRET, falling back to AZURE_CLIENT_ID / _SECRET

# --- GCP --------------------------------------------------------------------------------------
# Application Default Credentials (gcloud auth application-default login, or a key file):
# GOOGLE_APPLICATION_CREDENTIALS=
# Identity needs: resourcemanager.projects.create on gcp.projects.parent (if creating projects),
# Billing Account User, Service Usage Admin, BigQuery Admin, Storage Admin,
# Storage Transfer Admin (transfer.mode: sts).

# --- Optional ------------------------------------------------------------------------------------
# STS_LOG_LEVEL=INFO
# STS_ACCELERATOR_HOME=/home/airflow/gcs/dags
# MIGRATION_MAX_PARALLEL_TABLES=8
# MIGRATION_INCREMENTAL_SCHEDULE=@hourly
# MIGRATION_INCREMENTAL_ALL=0

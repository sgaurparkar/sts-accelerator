# Copy to .env (never commit .env).

# --- Azure SQL logins ---------------------------------------------------------
# Shared by every region ...
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
# ... and/or one pair per region when that server has its own login.
# Suffix = region name upper-cased, non-letters -> "_"   (East US -> _EAST_US,
# West US 2 -> _WEST_US_2, Germany West Central -> _GERMANY_WEST_CENTRAL).
# AZURE_SQL_USERNAME_EAST_US=
# AZURE_SQL_PASSWORD_EAST_US=

# --- Azure Blob staging -------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SAS_TOKEN=
# Per-region override (needed if a region sets its own storage_account):
# AZURE_STORAGE_CONNECTION_STRING_EAST_US=
# AZURE_SAS_TOKEN_EAST_US=

# --- Airflow only: default region when a DAG run has no {"region": ...} conf ---
# SOURCE_REGION=East US
